{
  "name": "enterprise-pos",
  "version": "1.0.0",
  "description": "Offline desktop POS application built with Electron, Tailwind CSS, and PostgreSQL.",
  "main": "src/main/main.js",
  "scripts": {
    "build": "npm run generate && npm run build:css && npm run typecheck",
    "build:css": "tailwindcss -i ./src/renderer/styles/input.css -o ./src/renderer/styles/output.css --minify",
    "watch:css": "tailwindcss -i ./src/renderer/styles/input.css -o ./src/renderer/styles/output.css --watch",
    "typecheck": "node scripts/type-check.js",
    "typecheck:ts": "node ./node_modules/typescript/bin/tsc --noEmit",
    "generate": "node scripts/generate.js",
    "db:health": "node scripts/db-health.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:first-run": "node scripts/first-run-setup.js",
    "db:pull": "node node_modules/prisma/build/index.js db pull",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:grocery": "node scripts/seed-grocery.js",
    "seed:suppliers": "node scripts/seed-suppliers.js",
    "smoke:auth": "node scripts/auth-smoke.js",
    "prestart": "npm run build:css",
    "start": "electron .",
    "dev": "concurrently \"npm:watch:css\" \"wait-on ./src/renderer/styles/output.css && electron .\"",
    "build:desktop": "npm run build && electron-builder --dir",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "predist": "npm run build",
    "dist": "electron-builder --win nsis portable",
    "prepack": "npm run build",
    "pack": "electron-builder --dir",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js}\" \"scripts/**/*.{ts,js}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js}\" \"scripts/**/*.{ts,js}\" \"*.{json,md}\"",
    "test:unit": "node node_modules/vitest/vitest.mjs run",
    "test:unit:watch": "node node_modules/vitest/vitest.mjs",
    "test:unit:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bin": {
    "generate": "scripts/generate.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.enterprisepos.desktop",
    "productName": "Enterprise POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!**/*.log",
      "!src/main/_backup_old_structure/**",
      "!_archive/**"
    ],
    "extraResources": [
      {
        "from": ".env.production.example",
        "to": ".env.production.example"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prisma": "^6.10.1",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  }
}
