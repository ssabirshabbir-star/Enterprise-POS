{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Language */
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],

    /* Strictness — active for new .ts files, advisory for .js */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,

    /* Incremental JS migration: existing .js files are type-checked but not rewritten */
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,

    /* Output */
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Interop */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* Paths (type-only aliases, no runtime bundling) */
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "_archive",
    "src/**/*.js",
    "scripts/**/*.js"
  ]
}
