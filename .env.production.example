# DATABASE_URL
# Used by Prisma. Assembled from PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD if not set.
# DATABASE_URL=

# PostgreSQL connection (existing — used by pg pool in src/main/database/connection.js)
PGHOST=localhost
PGPORT=5432
PGDATABASE=star
PGUSER=postgres
PGPASSWORD=

# JWT secrets (REQUIRED — change before any deployment)
JWT_ACCESS_SECRET=enterprise-pos-access-secret-change-before-production
JWT_REFRESH_SECRET=enterprise-pos-refresh-secret-change-before-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed defaults
SEED_ADMIN_EMAIL=admin@enterprisepos.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator

# Logging
LOG_LEVEL=debug

# Application
NODE_ENV=development
# POS_TERMINAL_CODE=T1
