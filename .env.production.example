NODE_ENV=production

# Prefer DATABASE_URL in production.
# Example: postgresql://postgres:CHANGE_ME@localhost:5432/star
DATABASE_URL=

# Alternative PostgreSQL variables if DATABASE_URL is not used.
PGHOST=localhost
PGPORT=5432
PGDATABASE=star
PGUSER=postgres
PGPASSWORD=
PGPOOL_MAX=8

# Generate long random secrets before deployment.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional production paths and printer defaults.
BACKUP_DIR=
PRINTER_MODE=windows

# Update provider foundation.
# manual = compare UPDATE_LATEST_VERSION against app version.
UPDATE_PROVIDER=manual
UPDATE_LATEST_VERSION=
UPDATE_DOWNLOAD_URL=

# License provider foundation for future SaaS activation server.
LICENSE_PROVIDER=local-foundation
LICENSE_SERVER_URL=

# Only used by first-run/admin seed commands. Do not keep weak passwords.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator
