{
  "*.{ts,tsx}": [
    "node ./node_modules/eslint/bin/eslint.js --fix --max-warnings=0",
    "node ./node_modules/prettier/bin/prettier.cjs --write"
  ],
  "*.{js,cjs,mjs}": ["node ./node_modules/prettier/bin/prettier.cjs --write"],
  "*.{json,md}": ["node ./node_modules/prettier/bin/prettier.cjs --write"]
}
