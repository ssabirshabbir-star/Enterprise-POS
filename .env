PGHOST=localhost
PGPORT=5432
PGDATABASE=star
PGUSER=postgres
PGPASSWORD=admin123

# DATABASE_URL is assembled from PG* variables by Prisma client singleton if not set
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/star

JWT_ACCESS_SECRET=enterprise-pos-access-secret-change-before-production
JWT_REFRESH_SECRET=enterprise-pos-refresh-secret-change-before-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SEED_ADMIN_EMAIL=admin@enterprisepos.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=System Administrator

LOG_LEVEL=debug
NODE_ENV=development
